# Copy this file to .env and fill in real values. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/dairy_db
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:3000

JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

ML_MODEL_PATH=app/ml/milk_yield_model.pkl
# Get this with: sha256sum app/ml/milk_yield_model.pkl
# Leave empty to skip the integrity check in development.
ML_MODEL_SHA256=

# Password reset emails. With no provider set, the reset link is written to the log (development only).
BREVO_API_KEY=
EMAIL_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=